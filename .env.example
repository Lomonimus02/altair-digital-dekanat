# Скопируйте в .env. Ключи облачных моделей не нужны и по умолчанию выключены.

DATABASE_URL=postgres://dekanat:dekanat@127.0.0.1:5432/dekanat
SESSION_SECRET=replace-with-a-long-random-string
# За Caddy (HTTPS) поставьте true, иначе браузер не сохранит сессию.
COOKIE_SECURE=false
PORT=4317
HOST=127.0.0.1
# Публичный адрес в QR на справке. За прокси это https://ваш-домен без слэша в конце.
PUBLIC_BASE_URL=http://127.0.0.1:4317
NODE_ENV=production
# true, если перед приложением TLS-прокси (Caddy). Иначе secure-cookie и IP лимита неверные.
TRUST_PROXY=false
LOG_LEVEL=info

# Необязательная самохостинговая модель (Ollama / llama.cpp, OpenAI-совместимый API).
# Данные студента уйдут только на этот адрес, не в облако. По умолчанию выключено:
# основной интеллект — модель в браузере (WebLLM).
# LOCAL_LLM_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=qwen2.5:3b
# LOCAL_LLM_API_KEY=

# Облачные адаптеры сознательно выключены. Не включайте для конкурса.
# ENABLE_CLOUD_LLM=false
# LLM_PROVIDER=
# GIGACHAT_AUTH_KEY=
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
