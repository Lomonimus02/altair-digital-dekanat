{
  "name": "workspace",
  "version": "1.0.0",
  "description": "Учебный концепт цифрового деканата «Альтаир». Вымышленные люди и оценки.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts && npm run build:api",
    "build:api": "esbuild server/src/index.ts --bundle --platform=node --target=node22 --outfile=server/dist/index.js --packages=external --format=esm && esbuild server/src/db/migrate.ts --bundle --platform=node --target=node22 --outfile=server/dist/migrate.js --packages=external --format=esm && esbuild server/src/db/seed.ts --bundle --platform=node --target=node22 --outfile=server/dist/seed.js --packages=external --format=esm && esbuild server/src/db/seed-homework.ts --bundle --platform=node --target=node22 --outfile=server/dist/seed-homework.js --packages=external --format=esm && esbuild server/src/db/seed-schedule-extend.ts --bundle --platform=node --target=node22 --outfile=server/dist/seed-schedule-extend.js --packages=external --format=esm",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/dist/index.js",
    "migrate": "node --env-file-if-exists=.env server/dist/migrate.js",
    "seed": "node --env-file-if-exists=.env server/dist/seed.js",
    "db:migrate": "tsx server/src/db/migrate.ts",
    "db:seed": "tsx server/src/db/seed.ts",
    "seed:homework": "node --env-file-if-exists=.env server/dist/seed-homework.js",
    "seed:classmates": "node --env-file-if-exists=.env server/dist/seed-homework.js --classmates",
    "db:seed:classmates": "tsx server/src/db/seed-homework.ts --classmates",
    "db:seed:homework": "tsx server/src/db/seed-homework.ts",
    "seed:schedule-extend": "node --env-file-if-exists=.env server/dist/seed-schedule-extend.js",
    "db:seed:schedule-extend": "tsx server/src/db/seed-schedule-extend.ts",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lomonimus02/altair-digital-dekanat"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.88",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "framer-motion": "^11.18.2",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.72.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
